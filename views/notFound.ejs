<% layout("./layouts/boilerplate") %>

<div class="error-page-wrapper">
  <div class="container">
    <div class="row justify-content-center align-items-center min-vh-100 py-5">
      <div class="col-lg-6 col-md-8 col-sm-10">
        
        <div class="error-card">
          <!-- Animated 404 Number -->
          <div class="error-number-wrapper">
            <h1 class="error-number">404</h1>
          </div>
          
          <!-- Error Content -->
          <div class="error-content">
            <h2 class="error-title">Page Not Found</h2>
            <p class="error-description">
              We couldn't find the page you're looking for. It may have been moved or deleted.
            </p>
          </div>
          
          <!-- Action Button -->
          <div class="error-actions">
            <a href="/" class="btn btn-primary btn-home">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-house-door-fill" viewBox="0 0 16 16">
                <path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5Z"/>
              </svg>
              <span>Return Home</span>
            </a>
          </div>
          
          <!-- Decorative Element -->
          <div class="error-decoration">
            <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" fill="currentColor" class="decoration-icon" viewBox="0 0 16 16">
              <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
            </svg>
          </div>
        </div>
        
      </div>
    </div>
  </div>
  
  <!-- Background Decoration -->
  <div class="bg-decoration bg-decoration-1"></div>
  <div class="bg-decoration bg-decoration-2"></div>
  <div class="bg-decoration bg-decoration-3"></div>
</div>

<style>
  /* Base Styles */
  .error-page-wrapper {
    min-height: 100vh;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    position: relative;
    overflow: hidden;
  }
  
  /* Background Decorations */
  .bg-decoration {
    position: absolute;
    border-radius: 50%;
    opacity: 0.1;
    pointer-events: none;
  }
  
  .bg-decoration-1 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    top: -150px;
    right: -150px;
    animation: float 20s ease-in-out infinite;
  }
  
  .bg-decoration-2 {
    width: 350px;
    height: 350px;
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
    bottom: -100px;
    left: -100px;
    animation: float 15s ease-in-out infinite reverse;
  }
  
  .bg-decoration-3 {
    width: 250px;
    height: 250px;
    background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    animation: pulse 10s ease-in-out infinite;
  }
  
  /* Error Card */
  .error-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-radius: 24px;
    padding: 3rem 2.5rem;  
    box-shadow: 
      0 20px 60px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.5);
    position: relative;
    z-index: 10;
    transition: transform 0.3s ease;
  }
  
  .error-card:hover {
    transform: translateY(-5px);
  }
  
  /* Error Number */
  .error-number-wrapper {
    position: relative;
    text-align: center;
    margin-bottom: 2rem;
  }
  
  .error-number {
    font-size: clamp(6rem, 15vw, 9rem);
    font-weight: 800;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
    margin: 0;
    position: relative;
    z-index: 2;
    animation: fadeInScale 0.8s ease-out;
  }
  
  .error-circle {
    position: absolute;
    width: 200px;
    height: 200px;
    background: linear-gradient(135deg, #667eea20 0%, #764ba230 100%);
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
    animation: rotate 20s linear infinite;
    display: none;
  }
  
  /* Error Content */
  .error-content {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  
  .error-title {
    font-size: 2rem;
    font-weight: 700;
    color: #2d3748;
    margin-bottom: 1rem;
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  
  .error-description {
    font-size: 1.1rem;
    color: #718096;
    line-height: 1.6;
    margin: 0;
    animation: fadeInUp 0.8s ease-out 0.3s both;
  }
  
  /* Action Button */
  .error-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }
  
  .error-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.3s ease;
    text-decoration: none;
    border: none;
    cursor: pointer;
  }
  
  .btn-home {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
  }
  
  .btn-home:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.5);
    color: #ffffff;
  }
  
  .btn-back {
    background: #ffffff;
    color: #4a5568;
    border: 2px solid #e2e8f0;
    display: none;
  }
  
  .btn-back:hover {
    background: #f7fafc;
    border-color: #cbd5e0;
    transform: translateY(-2px);
    color: #4a5568;
  }
  
  /* Decorative Element */
  .error-decoration {
    text-align: center;
    margin-top: 3rem;
  }
  
  .decoration-icon {
    color: #e2e8f0;
    animation: fadeIn 0.8s ease-out 0.5s both;
  }
  
  /* Animations */
  @keyframes float {
    0%, 100% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      transform: translate(30px, -30px) rotate(120deg);
    }
    66% {
      transform: translate(-20px, 20px) rotate(240deg);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 0.1;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 0.15;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }
  
  @keyframes rotate {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  
  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.8);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  
  /* Responsive Design */
  @media (max-width: 768px) {
    .error-card {
      padding: 2rem 1.5rem;
    }
    
    .error-title {
      font-size: 1.5rem;
    }
    
    .error-description {
      font-size: 1rem;
    }
    
    .error-actions .btn {
      padding: 0.75rem 1.5rem;
      font-size: 0.9rem;
    }
    
    .decoration-icon {
      width: 80px;
      height: 80px;
    }
  }
  
  @media (max-width: 480px) {
    .error-actions {
      flex-direction: column;
      width: 100%;
    }
    
    .error-actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>