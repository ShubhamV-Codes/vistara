<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
  <div class="show-content">

    <!-- Main Content -->
    <div class="main-content">

      <!-- Listing Title -->
      <div class="show-heading mb-4">
        <h2><%= listing.title %></h2>
        <p class="text-muted mb-0">
          <i class="bi bi-geo-alt-fill text-danger"></i>
          <%= listing.location %>
        </p>
      </div>

      <!-- Listing Image -->
      <div class="card shadow-lg mb-4 rounded-4 border-0">
        <img src="<%= listing.image.url %>" alt="listing_image" class="card-img-top rounded-4"
          style="height: 400px; object-fit: cover;" />
      </div>

      <!-- Listing Details -->
      <div class="card shadow-sm mb-4 rounded-3 border-0">
        <div class="card-body p-4">
          <div class="d-flex align-items-center mb-3">
            <div class="owner-avatar me-3">
              <%= listing.owner ? listing.owner.username.charAt(0).toUpperCase() : 'S' %>
            </div>
            <div>
              <p class="owner-name mb-0">
                Hosted by <%= listing.owner ? listing.owner.username : "Shubham" %>
              </p>
              <p class="text-muted mb-0" style="font-size: 0.9rem;">Property Owner</p>
            </div>
          </div>

          <hr>

          <p class="card-text text-muted mb-0"><%= listing.description %></p>
        </div>
      </div>

      <!-- ✅ Ad Section -->
      <div class="container my-4 text-center" style="max-width: 900px;">
        <ins class="adsbygoogle"
             style="display:block"
             data-ad-client="ca-pub-4053184614610082"
             data-ad-slot="4568104117"
             data-ad-format="auto"
             data-full-width-responsive="true"></ins>
        <script>
          (adsbygoogle = window.adsbygoogle || []).push({});
        </script>
      </div>

      <!-- Edit/Delete Buttons -->
      <% if (currUser && listing.owner && currUser._id.toString()===listing.owner._id.toString()) { %>
        <div class="d-flex gap-2 mb-4">
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning px-4">
            Edit
          </a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
            <button class="btn btn-danger px-4">
              Delete
            </button>
          </form>
        </div>
      <% } %>

      <hr class="my-4">

      <!-- Review Form -->
      <div class="mb-4">
        <% if (!currUser) { %>
          <div class="alert alert-info d-flex align-items-center justify-content-between" role="alert">
            <span>You need to login to add a review</span>
            <a href="/login" class="btn btn-primary btn-sm">Login</a>
          </div>
        <% } else { %>
          <h4 class="reviews-heading mb-3">Leave a Review</h4>
          <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

            <div class="mb-3">
              <label for="rating" class="form-label">Rating</label>
              <input type="number" name="review[rating]" min="1" max="5" class="form-control" required>
            </div>

            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" rows="4" class="form-control" required></textarea>
            </div>

            <button class="btn btn-outline-dark">Submit Review</button>
          </form>
        <% } %>
      </div>

    </div>

  </div>
</div>